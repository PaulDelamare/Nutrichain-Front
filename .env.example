# URL de l'API NutriChain (côté serveur SvelteKit — PAS de préfixe VITE_)
API_URL=http://localhost:3000

# Clé API transmise en x-api-key (obligatoire pour les routes protégées)
API_KEY=your-api-key-here

# Pas de NODE_ENV ici. Vite le pose lui-même selon la commande (`dev` → development,
# `build` → production) et lit `.env` AVANT : `NODE_ENV=development` y transformait
# `npm run build` en build de développement. Le bundle serveur émettait alors le nom
# d'amorçage `__sveltekit_dev` au lieu de celui du bundle client, l'hydratation plantait
# sur « Cannot read properties of undefined (reading 'env') », et l'application prévisualisée
# devenait un écran mort — les tests e2e qui cliquent tombaient, sans que rien dans le code
# n'ait bougé. Rien ne lit cette variable dans le front.
